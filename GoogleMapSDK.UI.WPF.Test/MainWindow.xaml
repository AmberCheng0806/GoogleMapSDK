<Window
    x:Class="GoogleMapSDK.UI.WPF.Test.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GoogleMapSDK.UI.WPF.Test"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="1000"
    Height="850"
    Background="#F5F6F8"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  上方：搜尋框（固定不動）  -->
        <Border
            Grid.Row="0"
            Padding="16,12"
            Panel.ZIndex="10"
            Background="White"
            BorderBrush="#EAECF0"
            BorderThickness="0,0,0,1">
            <StackPanel x:Name="AutoCompletePanel" />
        </Border>

        <!--  下方：可滾動內容  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <!--  輪播 + 地圖 並排  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="CarouselHost"
                        Grid.Column="0"
                        VerticalAlignment="Top" />

                    <Border
                        x:Name="GMapHost"
                        Grid.Column="2"
                        Height="320"
                        Background="White"
                        BorderBrush="#EAECF0"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="12" />
                </Grid>

                <!--  評論  -->
                <Border x:Name="ReviewsHost" Margin="0,16,0,0" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>