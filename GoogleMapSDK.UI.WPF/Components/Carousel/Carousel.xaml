<local:BaseCarousel
    x:Class="GoogleMapSDK.UI.WPF.Components.Carousel.Carousel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GoogleMapSDK.UI.WPF.Components.Carousel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Width="500" Height="300">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image
            x:Name="CarouselImage"
            Grid.Row="0"
            Stretch="Uniform" />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

            <Button
                x:Name="PreviousButton"
                Width="80"
                Margin="5"
                Content="上一張" />

            <Button
                x:Name="NextButton"
                Width="80"
                Margin="5"
                Content="下一張" />

        </StackPanel>

    </Grid>
</local:BaseCarousel>
