<UserControl
    x:Class="GoogleMapSDK.UI.WPF.Components.Review.Review"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GoogleMapSDK.UI.WPF.Components.Review"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Margin="10">

        <StackPanel Orientation="Horizontal">
            <Image
                x:Name="AuthorImage"
                Width="40"
                Height="40"
                Margin="0,0,10,0"
                Source="{Binding AuthorImg}" />
            <StackPanel>
                <TextBlock Text="{Binding AuthorName}" />
                <TextBlock Text="{Binding PublishTime}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
            <TextBlock Text="{Binding Stars}" />
            <TextBlock Margin="5,0,0,0" Text="{Binding Rating}" />
        </StackPanel>
        <TextBlock
            Margin="0,5,0,0"
            Text="{Binding ReviewText}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
