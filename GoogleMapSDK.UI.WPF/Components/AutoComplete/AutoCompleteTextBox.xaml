<UserControl
    x:Class="GoogleMapSDK.UI.WPF.Components.AutoComplete.AutoCompleteTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GoogleMapSDK.UI.WPF.Components.AutoComplete"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Name="AutoComplete" Grid.Row="0" />

        <Border
            Grid.Row="0"
            MaxHeight="200"
            Margin="0,28,0,0"
            VerticalAlignment="Top"
            Panel.ZIndex="999"
            Background="#2D2D30"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{Binding IsDropDownVisible, ElementName=Root}">
            <ListBox x:Name="ResultListBox" />
        </Border>
    </Grid>
</UserControl>
